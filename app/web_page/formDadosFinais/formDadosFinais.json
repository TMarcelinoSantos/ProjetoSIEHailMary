    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.pedidoTarefa ){",
        "\treturn {",
        "\t\t//map pedidoTarefa variable to expected task contract input",
        "\t\tpedidoTarefaInput: {",
        "\t\t\tsumariosIntrevencoes: $data.pedidoTarefa.sumariosIntrevencoes ? {",
        "\t\t\t\tdataIntrevencao: $data.pedidoTarefa.sumariosIntrevencoes.dataIntrevencao !== undefined ? $data.pedidoTarefa.sumariosIntrevencoes.dataIntrevencao : null,",
        "\t\t\t\tsumario: $data.pedidoTarefa.sumariosIntrevencoes.sumario !== undefined ? $data.pedidoTarefa.sumariosIntrevencoes.sumario : null,",
        "\t\t\t\thorasInvestidas: $data.pedidoTarefa.sumariosIntrevencoes.horasInvestidas !== undefined ? $data.pedidoTarefa.sumariosIntrevencoes.horasInvestidas : null",
        "\t\t\t} : null",
        "\t\t}",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
