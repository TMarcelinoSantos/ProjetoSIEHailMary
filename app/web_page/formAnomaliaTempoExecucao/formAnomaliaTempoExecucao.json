    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.anomalia ){",
        "\treturn {",
        "\t\t//map anomalia variable to expected task contract input",
        "\t\tanomaliaInput: {",
        "\t\t\temail: $data.anomalia.email !== undefined ? $data.anomalia.email : null,",
        "\t\t\ttipoDeAnomalia: $data.anomalia.tipoDeAnomalia !== undefined ? $data.anomalia.tipoDeAnomalia : null,",
        "\t\t\ttipoDeProcesso: $data.anomalia.tipoDeProcesso !== undefined ? $data.anomalia.tipoDeProcesso : null,",
        "\t\t\tidProcesso: $data.anomalia.idProcesso !== undefined ? $data.anomalia.idProcesso : null",
        "\t\t}",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}/context"
      ],
      "exposed" : false
    },
    "anomalia" : {
